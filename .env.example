# SentinelX Environment Configuration Template
# Copy this file to .env for local runtime configuration. Never commit .env with real secrets.

# General Application Settings
PROJECT_NAME="SentinelX"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="generate-a-secure-random-secret-key-for-production"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL + PostGIS + pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="sentinelx_user"
POSTGRES_PASSWORD="sentinelx_password"
POSTGRES_DB="sentinelx_db"
DATABASE_URL="postgresql+asyncpg://sentinelx_user:sentinelx_password@localhost:5432/sentinelx_db"
# Fallback SQLite for lightweight testing/Module 0:
DATABASE_URL_SQLITE="sqlite+aiosqlite:///./sentinelx_dev.db"

# Cache / Event Bus (Valkey / Redis compatible)
VALKEY_HOST="localhost"
VALKEY_PORT=6379
VALKEY_URL="redis://localhost:6379/0"

# Sentinel Sandbox Ingestion Configuration
SENTINEL_CATALOG_URL="http://localhost:8000/api/ingest"
SENTINEL_HOST="localhost"
SENTINEL_RTSP_PORT=8554
SENTINEL_WHEP_PORT=8889
SENTINEL_HLS_PORT=80
SENTINEL_SYNC_INTERVAL_SECONDS=30

# AI Pipeline & Vision
AI_DEVICE="cpu" # "cuda" or "cpu"
DETECTION_CONFIDENCE_THRESHOLD=0.45
ANPR_CONFIDENCE_THRESHOLD=0.60
TRACK_MAX_AGE=30
TRACK_MIN_HITS=3

# Storage & Evidence
EVIDENCE_STORAGE_PATH="./data/evidence"
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB

# Authentication & Security
JWT_SECRET="sentinelx-super-secret-jwt-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS & Frontend
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
