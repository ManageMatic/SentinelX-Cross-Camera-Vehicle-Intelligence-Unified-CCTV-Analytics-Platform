# NETRA-X / SentinelX Environment Configuration Template
# Copy this file to .env (or backend/.env) for local runtime configuration.
# NEVER commit real credentials to Git.

# General Application Settings
PROJECT_NAME="NETRA-X — Unified Vehicle Tracking & Command Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="generate-a-secure-random-secret-key-for-production"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL + PostGIS + pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="sentinelx_user"
POSTGRES_PASSWORD="sentinelx_password"
POSTGRES_DB="sentinelx_db"
DATABASE_URL="sqlite+aiosqlite:///./sentinelx_dev.db"

# Cache / Event Bus (Valkey / Redis compatible)
VALKEY_HOST="localhost"
VALKEY_PORT=6379
VALKEY_URL="redis://localhost:6379/0"

# Sentinel CCTV Authenticated RTSP Ingestion
SENTINEL_RTSP_HOST="103.250.160.189"
SENTINEL_RTSP_PORT=8554
SENTINEL_USERNAME="your-registered-email@example.com"
SENTINEL_ACCESS_CODE="your-sentinel-access-code"
SENTINEL_RTSP_TRANSPORT="tcp"
SENTINEL_CONNECTION_TIMEOUT=10000
SENTINEL_RECONNECT_MAX_DELAY=30
SENTINEL_CAMERA_PREFIX="cam"
SENTINEL_CAMERA_START=1
SENTINEL_CAMERA_END=30

# WebRTC (WHEP) & HLS Ports
SENTINEL_WHEP_PORT=8889
SENTINEL_HLS_PORT=80
SENTINEL_SYNC_INTERVAL_SECONDS=30

# AI Pipeline & Vision
AI_DEVICE="cpu" # "cuda" or "cpu"
DETECTION_CONFIDENCE_THRESHOLD=0.45
ANPR_CONFIDENCE_THRESHOLD=0.60
TRACK_MAX_AGE=30
TRACK_MIN_HITS=3

# Storage & Evidence
EVIDENCE_STORAGE_PATH="./data/evidence"
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB

# Authentication & Security
JWT_SECRET="dev-insecure-jwt-secret-key-must-change-in-prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS & Frontend
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
